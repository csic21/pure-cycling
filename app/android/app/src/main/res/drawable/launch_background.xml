<?xml version="1.0" encoding="utf-8"?>
<!-- Pure black, always. The app is OLED-first and has no light theme, so the
     window between process start and the first Flutter frame must be black
     too — anything else is a flash of the wrong colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
</layer-list>
