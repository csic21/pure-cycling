# Copy to .env.local (gitignored) and fill in.
#
#   supabase functions serve --env-file supabase/functions/.env.local
#
# Deployed projects use `supabase secrets set` instead.

# Required. A Web 服务 key from 高德开放平台.
AMAP_KEY=

# Optional for forks. Must match the repository that builds the APK.
RELEASE_REPOSITORY=csic21/pure-cycling
# Optional: improves the GitHub API quota. Without it, the relay uses a
# documented public Release permalink when the anonymous API is rate limited.
GITHUB_TOKEN=

# Optional overrides, both for verification:
#   AMAP_BASE_URL    point the relay at a stub instead of the vendor
#   ROUTE_DAILY_LIMIT  per-account calls per day (default 200)
