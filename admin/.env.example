# Copy to .env.local and fill in. Never commit .env.local.

# The same project the app syncs to. Local stack defaults:
#   supabase status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS, so it must never be prefixed with NEXT_PUBLIC_
# and never reach a browser. From `supabase status` locally, or the cloud
# project's API settings.
SUPABASE_SERVICE_ROLE_KEY=
