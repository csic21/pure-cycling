# ===========================================================================
# Credentials
#
# None of these are committed, ever. See docs/ci.md for how they reach a build
# instead.
# ===========================================================================

# Local development values for `--dart-define-from-file`. The committed
# template is app/dart_define.example.json.
app/dart_define.json
.env
.env.*
# …but templates are committed on purpose: they are how a new clone learns
# which variables exist. Only files that hold values are ignored.
!**/.env.example

# Android upload key. Losing it means you can never update the app under the
# same listing; leaking it means somebody else can.
*.jks
*.keystore
app/android/key.properties

# Supabase CLI local state, which holds a local service_role key.
supabase/.temp/
supabase/.branches/

# ===========================================================================
# Flutter / Dart
# ===========================================================================

app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
app/**/*.iml

# Generated by `dart run build_runner build`, and deliberately not committed:
# a stale checked-in copy is how a schema change silently fails to take effect.
# CI regenerates before analysing.
app/**/*.g.dart

# ===========================================================================
# Platform build output
# ===========================================================================

app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/ephemeral/
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
app/macos/Pods/
app/macos/Flutter/ephemeral/
app/macos/Flutter/GeneratedPluginRegistrant.swift
app/android/.gradle/
app/android/local.properties
# Gradle writes some reports here even though the main build directory is
# redirected to app/build by the root build script.
app/android/build/
app/ios/build/
app/macos/build/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/

# ===========================================================================
# OS and editors
# ===========================================================================

.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
